# ─── Big Data Infrastructure & Runtime ────────────────────────────────────────
# Apache Spark, Hadoop, Kafka, Neo4j runtime artifacts & metastores
metastore_db/
derby.log
spark-warehouse/
spark-events/
.checkpoint/
checkpoint/
data/neo4j/
data/kafka/
data/zookeeper/
data/hadoop/

# ─── Large Raw Data ───────────────────────────────────────────────────────────
# Raw LANL netflow and network capture files (multi-GB / multi-hundred MB)
data/raw/*.txt.gz
data/raw/*.gz
data/raw/*.tar.gz
data/raw/*.zip
data/raw/flows*.txt
data/raw/auth*.txt
data/raw/proc*.txt
data/raw/dns*.txt
# Keep ground-truth labels and metadata tracked
!data/raw/redteam.txt
!data/raw/redteam_labels.csv

# ─── Processed / Aggregated Parquet Datasets ──────────────────────────────────
# Aggregated and split datasets generated by ETL / Spark pipelines
*.parquet
data/parquet/
reports/data/*.parquet

# Large NetFlow raw export text files (5.2+ GB, exceeds GitHub limits)
reports/data/flows.txt
reports/data/*.txt

# ─── Generated Figures & Interactive Visualizations ───────────────────────────
# Large standalone Plotly HTML bundles (~4–5 MB each, regenerated by scripts)
reports/figures/
visualizations/*.html
!visualizations/index.html
!visualizations/15_neo4j_bloom_view.html

# ─── Generated Report Artefacts & Results ─────────────────────────────────────
# Per-run prediction JSONs (regenerated by evaluate.py)
reports/data/preds_*.json
# Per-run result tables (regenerated by evaluate.py / run_all.py)
reports/tables/baselines_delta*.json
reports/tables/training_results.json
reports/tables/calibration.csv
reports/tables/final_results.csv

