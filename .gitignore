# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.env

# ─── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Model Checkpoints ────────────────────────────────────────────────────────
# PyTorch weights — large binary blobs, not suited for Git
checkpoints/

# ─── Large Raw Data ───────────────────────────────────────────────────────────
# flows_slice.txt is ~1.7 GB
data/raw/flows_slice.txt
# dns.txt.gz is ~185 MB
data/raw/dns.txt.gz
# Aggregated parquet files (50–80 MB each, regenerated by ETL pipeline)
data/parquet/

# ─── Processed / Split Datasets ───────────────────────────────────────────────
# train/val/test splits are generated by the pipeline
reports/data/train.parquet
reports/data/val.parquet
reports/data/test.parquet
reports/data/candidates_all.parquet
reports/data/flows.txt
# ─── Generated Figures (large Plotly HTML bundles ~4–5 MB each) ───────────────
reports/figures/

# ─── Generated Report Artefacts ───────────────────────────────────────────────
# Per-run prediction JSONs (regenerated by evaluate.py)
reports/data/preds_*.json
# Per-run result tables (regenerated by evaluate.py / run_all.py)
reports/tables/baselines_delta*.json
reports/tables/training_results.json
reports/tables/calibration.csv
reports/tables/final_results.csv

